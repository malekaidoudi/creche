# ============================================
# CONFIGURATION E-MAILS - RESEND
# ============================================

# Clé API Resend (obligatoire)
# Obtenir sur: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# ADRESSES E-MAIL
# ============================================

# Adresse d'expédition par défaut
# Format: "Nom <email@domaine.com>"
EMAIL_FROM=Crèche Mima Elghalia <noreply@mima-elghalia.com>

# Adresse pour recevoir les messages de contact
CONTACT_EMAIL=crechemimaelghalia@gmail.com

# ============================================
# CONFIGURATION FRONTEND
# ============================================

# URL du frontend (pour les liens dans les e-mails)
# Production
FRONTEND_URL=https://malekaidoudi.github.io/creche

# Développement local
# FRONTEND_URL=http://localhost:5173

# ============================================
# NOTES IMPORTANTES
# ============================================

# 1. Domaine vérifié dans Resend
#    - Aller sur https://resend.com/domains
#    - Ajouter le domaine mima-elghalia.com
#    - Configurer les enregistrements DNS (SPF, DKIM, DMARC)
#    - Attendre la vérification (peut prendre quelques heures)

# 2. Adresses d'expédition configurées
#    Les adresses suivantes doivent être configurées dans Resend:
#    - contact@mima-elghalia.com (messages généraux)
#    - noreply@mima-elghalia.com (notifications automatiques)
#    - inscription@mima-elghalia.com (suivi des inscriptions)

# 3. Limites Resend (plan gratuit)
#    - 100 e-mails par jour
#    - 3 000 e-mails par mois
#    - Pour plus: https://resend.com/pricing

# 4. Test en local
#    Pour tester sans envoyer de vrais e-mails:
#    node scripts/test-email-system.js votre-email@example.com

# 5. Monitoring
#    Dashboard Resend: https://resend.com/emails
#    Logs en base de données: SELECT * FROM email_logs ORDER BY created_at DESC;
