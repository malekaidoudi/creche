{
  "name": "creche-backend",
  "version": "2.0.0",
  "description": "Backend API pour le système de gestion de crèche",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'Backend build completed - no build step required'",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/utils tests/middleware --coverage",
    "db:init": "node scripts/init-database-v1.js",
    "db:migrate": "node scripts/init-database-v1.js",
    "db:migrate:v2": "node migrations/migrate_existing_data.js",
    "migrate:cloudinary": "node scripts/migrate-documents-to-cloudinary.js",
    "seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset-database.js && npm run db:init && npm run seed",
    "postinstall": "echo 'Backend dependencies installed successfully'"
  },
  "keywords": [
    "api",
    "express",
    "postgresql",
    "jwt",
    "creche"
  ],
  "author": "Creche Management Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.4",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "resend": "^6.4.2"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "utils/**/*.js",
      "middleware/**/*.js",
      "controllers/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [],
    "verbose": true
  }
}
