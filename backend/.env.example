# Configuration PostgreSQL Neon
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_USER=your-neon-user
DB_PASSWORD=your-neon-password
DB_NAME=your-database-name
DB_SSL=require

# JWT
# OBLIGATOIRE : le serveur refuse de démarrer si cette variable est absente
# (plus de valeur par défaut codée en dur dans le code, cf. documentsV2/23_ANOMALIES_ET_RECOMMANDATIONS.md, anomalie #1).
# Générez une valeur longue et aléatoire, ex: openssl rand -hex 64
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production

# SMTP Hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@mima-elghalia.com
SMTP_PASS=your-smtp-password

# Email Configuration
EMAIL_FROM=Crèche Mima Elghalia <contact@mima-elghalia.com>
CONTACT_EMAIL=contact@mima-elghalia.com
FRONTEND_URL=https://your-frontend-url.com

# Environnement
NODE_ENV=production
PORT=8080

# CORS (optionnel) — cf. documentsV2/23_ANOMALIES_ET_RECOMMANDATIONS.md, anomalie #2
# CLIENT_URL : une origine supplémentaire autorisée à appeler l'API (ex. le domaine
#              GitHub Pages déclaré dans backend/render.yaml). Vient s'ajouter à la
#              liste d'origines codée en dur dans backend/server.js, pas la remplacer.
# CORS_ADDITIONAL_ORIGINS : plusieurs origines supplémentaires, séparées par des virgules.
# CLIENT_URL=https://votre-domaine-frontend.example.com
# CORS_ADDITIONAL_ORIGINS=https://autre-domaine.example.com,https://encore-un-autre.example.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# URL complète pour migrations (optionnel)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Flags de débogage (optionnel - développement uniquement)
# DEBUG_AUTH=true          # Active le log du payload JWT décodé sur les requêtes

# Assistant IA Google Gemini (Centre d'aide intelligent)
GEMINI_API_KEY=your-gemini-api-key
